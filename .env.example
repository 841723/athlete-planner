# Google OAuth Client ID (tipo "Web application"). Necesario para iniciar sesión.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Email de la cuenta de Google que será owner del tenant inicial tras migrar.
DEFAULT_OWNER_EMAIL=

# Puerto interno del backend (el frontend proxea /api).
PORT=4000

# Fecha mínima de sincronización con Garmin (YYYY-MM-DD).
MIN_DATE=2026-05-12
